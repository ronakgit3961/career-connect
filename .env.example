# CareerConnect Server Configuration Template
# Copy this file to .env and adjust the values as needed

PORT=5001
NODE_ENV=development
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key
DB_PATH=./server/data/careerconnect.db

# Legitimate External Job Board APIs
# Arbeitnow: Public Job Board API (No API key required for public access)
# Real tech, remote, and hybrid job listings across EU/Global
EXTERNAL_JOBS_API=https://www.arbeitnow.com/api/job-board-api

# Remotive: Remote Job Listing API (No API key required for public access)
REMOTIVE_API=https://remotive.com/api/remote-jobs

# Frontend API base URL
VITE_API_URL=/api
